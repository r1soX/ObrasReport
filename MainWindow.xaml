<Window x:Class="ObrasReport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт по обработке обращений" Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Отчёт по обработке обращений" FontSize="20" FontWeight="Bold" Foreground="#1F4E78"/>
            <TextBlock Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Загрузите две и более выгрузок (.xlsx) по разным датам одной категории. Формат определяется автоматически. Итог: «Обработано» / «На контроле исполнения». Если дата не распозналась из имени файла — выберите её списками день · месяц · год. Порядок в отчёте выставляется по дате автоматически."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Добавить файлы…" Click="AddFiles_Click"/>
                <Button Content="Удалить" Click="Remove_Click"/>
                <Button Content="Вверх" Click="Up_Click"/>
                <Button Content="Вниз" Click="Down_Click"/>
                <Button Content="Очистить" Click="Clear_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Вид отчёта:" VerticalAlignment="Center" Foreground="#444" Margin="0,0,6,0"/>
                <ComboBox x:Name="TemplateCombo" Width="210" Height="28" SelectedIndex="0"
                          SelectionChanged="Template_Changed"
                          ToolTip="Авто: обращения 1С — как раньше; любые другие таблицы — универсальное сравнение">
                    <ComboBoxItem Content="Авто (определить самому)"/>
                    <ComboBoxItem Content="Обращения (Обработано / На контроле)"/>
                    <ComboBoxItem Content="Универсальное сравнение"/>
                    <ComboBoxItem Content="Динамика (закрытые обращения/наряды)"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- шапка -->
                <Grid Grid.Row="0" Background="#F2F5F8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="235"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Дата выгрузки (день · месяц · год)" FontWeight="SemiBold" Margin="10,8" Foreground="#334"/>
                    <TextBlock Grid.Column="1" Text="Категория отчёта" FontWeight="SemiBold" Margin="6,8" Foreground="#334"/>
                    <TextBlock Grid.Column="2" Text="Обращений" FontWeight="SemiBold" Margin="6,8" Foreground="#334"/>
                    <TextBlock Grid.Column="3" Text="Файл" FontWeight="SemiBold" Margin="6,8" Foreground="#334"/>
                </Grid>

                <ListBox x:Name="Grid" Grid.Row="1" BorderThickness="0"
                         SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
                    <ListBox.Resources>
                        <Style TargetType="ComboBox" x:Key="DateCombo">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="235"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <ComboBox Style="{StaticResource DateCombo}" Width="56"
                                              ItemsSource="{Binding Days}"
                                              SelectedItem="{Binding Day, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="День"/>
                                    <ComboBox Style="{StaticResource DateCombo}" Width="56"
                                              ItemsSource="{Binding Months}"
                                              SelectedItem="{Binding Month, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Месяц"/>
                                    <ComboBox Style="{StaticResource DateCombo}" Width="76"
                                              ItemsSource="{Binding Years}"
                                              SelectedItem="{Binding Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Год"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource DateCombo}" Margin="6,0" Width="216"
                                          HorizontalAlignment="Left" ItemsSource="{Binding CategoryOptions}"
                                          SelectedItem="{Binding Category, Mode=TwoWay}"
                                          ToolTip="Категория — файлы одной категории объединяются в один отчёт"/>
                                <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" Margin="6,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding FileName}" VerticalAlignment="Center" Margin="6,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="3" x:Name="MappingPanel" Visibility="Collapsed" Margin="0,10,0,0"
                Background="#F7FAFC" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="Универсальный режим — настройка колонок:" FontWeight="SemiBold" Foreground="#1F4E78" Margin="0,0,0,6"/>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6" VerticalAlignment="Center">
                        <TextBlock Text="Ключ (ID):" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#444"/>
                        <ComboBox x:Name="KeyCombo" Width="200" Height="26"
                                  ToolTip="Столбец-идентификатор для сопоставления строк между датами"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6" VerticalAlignment="Center">
                        <TextBlock Text="Отслеживаемый:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#444"/>
                        <ComboBox x:Name="TrackedCombo" Width="200" Height="26"
                                  ToolTip="Столбец, значение которого показывается по датам; его изменение = «Изменено»"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Колонки в отчёт:" Foreground="#444" Margin="0,4,0,4"/>
                <Border MaxHeight="96" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" CornerRadius="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                        <ItemsControl x:Name="ColumnsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="4,3" Width="200"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="Описание отчёта (необязательно):" Foreground="#444" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionBox" MinHeight="46" MaxHeight="90" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     BorderBrush="#DDE3EA" Padding="6"
                     ToolTip="Например: контроль исполнения обращений по ремонтам за период 01.07–07.07. Текст попадёт в отчёт."/>
        </StackPanel>

        <Border Grid.Row="5" Background="#F5F7FA" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="4"
                Margin="0,10,0,10" MinHeight="56" MaxHeight="120">
            <TextBox x:Name="Log" Background="Transparent" BorderThickness="0" Margin="10"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Foreground="#333"
                     Text="Готово к работе. Перетащите файлы в окно или нажмите «Добавить файлы…»."/>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Foreground="#777" FontSize="12">
                    <Run Text="Разработчик: "/><Run Text="Смолин Владислав Сергеевич" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Text="Старший администратор инфраструктуры" Foreground="#999" FontSize="11"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Сформировать отчёт" Click="Generate_Click" FontWeight="Bold"
                    Background="#1F4E78" Foreground="White" MinWidth="200" Padding="16,8"/>
        </Grid>
    </Grid>
</Window>
